# --- Experiencia ---
VITE_COUNTDOWN_SECONDS=10
VITE_SUCCESS_SECONDS=5
VITE_SESSION_TIMEOUT_MS=60000
VITE_SESSION_WARNING_SECONDS=15
VITE_BRAND_TITLE=FERIA DE LOJA
VITE_BRAND_SUBTITLE=Photo Booth
VITE_BRAND_FOOTER=NODO
VITE_MIRROR_CAMERA=true

# --- Efecto de la foto ---
# cartoon = caricatura rubber hose | none = foto tal cual
VITE_PHOTO_EFFECT=cartoon
VITE_PHOTO_FRAME=true
# Ovalo guia: encuadra la cara y define donde deforma el estilo Cabezon.
VITE_FACE_CX=0.5
VITE_FACE_CY=0.42
VITE_FACE_W=0.30
VITE_FACE_H=0.46

# --- Camara: demo | webcam | service ---
VITE_CAMERA_MODE=webcam
VITE_DEMO_PHOTO=/demo-photo.svg
VITE_CAMERA_SERVICE_URL=http://localhost:5000

# --- Backend
VITE_API_MODE=fake
VITE_API_BASE_URL=http://localhost:3000
# multipart | base64 | two-step   <-- ACORDAR CON EL BACKEND
VITE_UPLOAD_STRATEGY=multipart
VITE_API_TIMEOUT_MS=30000

# --- Datos personales ---
VITE_CONSENT_TEXT=Acepto que se use mi correo y celular unicamente para enviarme esta foto.

# --- Sonido ---
VITE_SOUND_ENABLED=true

# --- Cola de envios pendientes (si se cae la red) ---
VITE_QUEUE_MAX_ITEMS=12
VITE_QUEUE_MAX_AGE_HOURS=12
VITE_QUEUE_RETRY_MS=45000

# --- Generacion con IA (via backend) ---
# off = filtro local del totem | real = se lo pide al backend
VITE_AI_MODE=off
VITE_AI_TIMEOUT_MS=60000

# Endpoint y opciones del generador. Los nombres de los campos que se
# mandan son los del DTO del backend (prompt, image, provider, model...).
VITE_AI_ENDPOINT=/image-generation/upload
# gemini | qwen   (vacio = que decida el backend)
VITE_AI_PROVIDER=
# ej. qwen-image-3.0
VITE_AI_MODEL=
# Resolucion de salida. 3:4 como el totem, rapida de generar.
VITE_AI_SIZE=768*1024
# Lado mayor de la foto que se sube (mas chica = menos espera)
VITE_AI_UPLOAD_MAX_PX=1024
# Mandar styleId y groupId. Solo si el backend los acepta: NestJS con
# forbidNonWhitelisted rechaza con 400 los campos que no esten en el DTO.
VITE_AI_SEND_METADATA=false

# Pantalla de espera mientras se genera la imagen
VITE_PROCESSING_MIN_MS=900
VITE_PROCESSING_SLOW_SECONDS=10

# --- Publicacion ---
# Direccion PUBLICA de esta app: es lo que va dentro del QR de descarga.
# Con localhost o una IP local el QR no abre nada en el celular.
VITE_PUBLIC_BASE_URL=https://nodo.com.ec/feria
# Prefijo de los endpoints de la descarga en el backend
VITE_DOWNLOAD_API_PATH=/feria
VITE_DOWNLOAD_ENDPOINT=/feria/photos
